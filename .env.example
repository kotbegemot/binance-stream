# Copy to .env and edit if you need to override defaults.
# All variables are optional; sensible defaults are baked into AppConfig.

# Binance spot market data WebSocket. Use wss://fstream.binance.com for
# perpetual futures (would also require switching the parser to the
# futures bookTicker shape — not implemented here).
QUOTES_BINANCE_WS_URL=wss://data-stream.binance.vision

# SQLite file path inside the container. The compose service bind-mounts
# ./data → /data, so quotes survive `docker compose down`.
QUOTES_DB_PATH=/data/quotes.db

# HTTP port the service listens on inside the container; the host port
# is also taken from this value via the compose `ports:` mapping.
QUOTES_HTTP_PORT=8080

# SQLite writer batching: flush after batchMaxSize quotes OR
# batchMaxWaitMs since the first quote in the current batch, whichever
# comes first.
QUOTES_BATCH_MAX_SIZE=100
QUOTES_BATCH_MAX_WAIT_MS=50

# Hard cap for /quotes/{symbol}/history?limit=N. Requests above this
# return 400. Reads above default 100 are explicit opt-in.
QUOTES_HISTORY_MAX_LIMIT=10000

# Source for the top-10 ranking on first start. `coingecko` queries
# the CoinGecko API; `static` uses instruments-fallback.yaml verbatim
# and skips any HTTP call.
QUOTES_RANKING_SOURCE=coingecko
QUOTES_COINGECKO_URL=https://api.coingecko.com
QUOTES_COINGECKO_TIMEOUT_MS=5000

# Periodic re-query of CoinGecko after first start. 0 disables
# (default — admin owns the tracked list). Refresh is add-only.
QUOTES_RANKING_REFRESH_HOURS=0
# Millisecond override of the above, primarily for integration tests.
# QUOTES_RANKING_REFRESH_MS=

# Optional API key gate for /admin/* endpoints. When empty (default),
# admin endpoints are unauthenticated — fine for local dev. When set,
# all /admin/* requests must include header `X-Admin-Key: <value>` or
# get 401. Note: single shared-secret model, not enterprise auth.
QUOTES_ADMIN_API_KEY=

# CORS allowed origins (comma-separated). When empty (default), CORS is
# disabled — no Access-Control-Allow-Origin header is emitted and the
# browser blocks cross-origin XHR. When set, only those origins receive
# the header and can call the API from a browser.
# Example: QUOTES_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
QUOTES_CORS_ALLOWED_ORIGINS=

# Per-request async timeout in milliseconds. When > 0, every handler runs
# on a virtual-thread executor wrapped in a CompletableFuture.orTimeout —
# if the handler doesn't finish in time, the response is 408 Request
# Timeout. Default 0 = no timeout (handlers run to completion).
QUOTES_HTTP_TIMEOUT_MS=0